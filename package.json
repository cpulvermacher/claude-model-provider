{
    "name": "claude-model-provider",
    "publisher": "cpulvermacher",
    "displayName": "Claude Model Provider",
    "description": "Provides Claude language models via the Anthropic API",
    "icon": "images/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/cpulvermacher/claude-model-provider.git"
    },
    "version": "0.6.0",
    "engines": {
        "vscode": "^1.107.0"
    },
    "categories": [
        "AI",
        "Chat",
        "Machine Learning"
    ],
    "keywords": [
        "ai",
        "chat",
        "language model",
        "claude",
        "anthropic",
        "sonnet",
        "opus"
    ],
    "enabledApiProposals": [],
    "activationEvents": [],
    "contributes": {
        "languageModelChatProviders": [
            {
                "vendor": "claude-model-provider",
                "displayName": "claude"
            }
        ],
        "commands": [
            {
                "command": "claude-model-provider.updateApiKey",
                "title": "Claude Model Provider: Update API Key"
            }
        ],
        "configuration": {
            "title": "Claude Model Provider",
            "properties": {
                "claude-model-provider.promptCaching": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Cache the request prefix for 5min using Anthropic API's [prompt caching](https://docs.anthropic.com/en/docs/build-with-claude/prompt-caching). Later turns in a conversation re-read the cached prefix at reduced cost. If you are mainly sending single requests, rather than multi-turn conversations, you may want to turn this off."
                }
            }
        }
    },
    "main": "./out/extension.js",
    "scripts": {
        "vscode:prepublish": "rm -rf out/ && npm run esbuild-base -- --minify",
        "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
        "build": "pnpm exec vsce package --no-dependencies",
        "format": "pnpm exec biome check --write src/",
        "lint": "tsc --noEmit && pnpm exec biome check src/",
        "test": "vitest run",
        "watch": "tsc -watch -p ./"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.110.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.16",
        "@types/node": "24.x",
        "@types/vscode": "1.107.0",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "^0.28.1",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
